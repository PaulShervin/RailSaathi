# RailSathi AI — Environment Configuration
# Copy this file to .env and fill in values

# === Required ===
GEMINI_API_KEY=

# === Optional ===
FLASK_ENV=development
FLASK_PORT=5000
FLASK_DEBUG=1

# Agent controller limits
MAX_AGENT_ROUNDS=4
MAX_TOOL_CALLS=6

# Gemini model configuration
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_OUTPUT_TOKENS=2048

# Logging
LOG_LEVEL=INFO
LOG_DIR=backend/logs

# === Train Data Provider (RailRadar vs Mock) ===
# Set to 'railradar' for live schedules and fares, or 'mock' for offline dev/testing
TRAIN_DATA_PROVIDER=railradar
RAILRADAR_API_KEY=
RAILRADAR_BASE_URL=https://api.railradar.in
RAILRADAR_TIMEOUT_SECONDS=10
RAILRADAR_MAX_RETRIES=1
RAILRADAR_MAX_FARE_LOOKUPS_PER_REQUEST=5
RAILRADAR_CACHE_ENABLED=1

# Journey Planner & Location Services
GEOCODING_PROVIDER=railsaathi_geo_registry
OSRM_ROUTING_ENDPOINT=
NTES_TIMETABLE_SOURCE=official_cris_ntes

